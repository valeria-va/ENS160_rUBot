<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ens160_sensors</name>
  <version>0.0.0</version>
  <description>Publish data from 6 ENS160 sensors and subscribe to the robot's pose information</description>
  <maintainer email="vvalleay94@alumnes.ub.edu">root</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>ens160_interfaces</depend>

  <build_depend>rosidl_default_runtime</build_depend>

  <exec_depend>ros2launch</exec_depend>
  <exec_depend>rosidl_default_generators</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
